{
  "name": "incident-kit",
  "version": "0.1.0",
  "description": "Incident management that lives in a GitHub repository: issue form, slash commands, on-call rotation, notifications, a status page on GitHub Pages and postmortem pull requests.",
  "keywords": [
    "incident-management",
    "incident-response",
    "status-page",
    "on-call",
    "postmortem",
    "sre",
    "github-action",
    "github-pages",
    "tech-lead"
  ],
  "homepage": "https://github.com/nuttakulsv/incident-kit#readme",
  "bugs": "https://github.com/nuttakulsv/incident-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuttakulsv/incident-kit.git"
  },
  "license": "MIT",
  "author": "nuttakulsv",
  "type": "module",
  "bin": {
    "incident-kit": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "oxlint src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/cli.ts build-site --demo examples/demo/incidents.json --config examples/demo/incident-kit.yml --out site",
    "images": "tsx scripts/readme-images.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
